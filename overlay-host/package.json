{
  "name": "coachbuild-overlay-host",
  "version": "0.4.2",
  "private": true,
  "description": "Always-on-top Electron overlay host for CoachBuild's League of Legends skill-order reference. Replaces the Overwolf app (blocked by Overwolf's developer-whitelist/ads-integration requirement) -- see HANDOFF-engy.md's 2026-07-27 PIVOT entry. Independent of the Next.js app: its own package.json/node_modules on purpose, not part of the Next build.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:admin": "start-admin.cmd",
    "vendor:bundle": "esbuild ../lib/nextSkill.ts --bundle --format=esm --platform=browser --outfile=vendor/skillEngine.js",
    "dist:unpacked": "electron-builder --dir --win",
    "dist:resources": "node scripts/apply-exe-resources.js",
    "dist:package": "electron-builder --win nsis portable --prepackaged dist/win-unpacked",
    "dist": "npm run dist:unpacked && npm run dist:resources && npm run dist:package",
    "dist:publish": "npm run dist:unpacked && npm run dist:resources && electron-builder --win nsis portable --prepackaged dist/win-unpacked --publish always"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.coachbuild.overlay",
    "productName": "CoachBuild Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "calibratePreload.js",
      "lib/**/*",
      "js/**/*",
      "vendor/skillEngine.js",
      "assets/**/*",
      "renderer/**/*",
      "package.json",
      "!vendor/_selfTest-highlight.mjs",
      "!assets/*.bak"
    ],
    "extraResources": [
      {
        "from": "../public/companion.ps1",
        "to": "companion.ps1"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "haroutB5",
        "repo": "coachbuild-overlay-releases",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
