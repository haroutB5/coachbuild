<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <!-- The real 173-entry GET /api/champions body, captured 2026-08-18. Held-out
         data: it was not written to suit the resolver, so a normalisation rule
         that only works on hand-picked champions fails against it. -->
    <None Include="Fixtures\champions.live.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- probuildstats SSR captures (2026-09-11, patch 16.18 live): the Pro
         import parses these byte-identical, through the same script-tag read
         the client performs. pbs-ahri-top.html is the transient 718-byte
         "technical issues" shell (no apollo JSON: retryable); pbs-badslug is
         the unknown-champion shape (empty apollo state). -->
    <None Include="Fixtures\pbs-ahri.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\pbs-jhin.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\pbs-badslug.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\pbs-ahri-top.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CoachBuild.Core\CoachBuild.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
