<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms are both enabled for the tray; source uses explicit Wpf*/Forms aliases for shared type names. -->
    <StartupObject>CoachBuild.Desktop.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <Version>1.0.22</Version>
    <ApplicationIcon>Assets\tray-icon.ico</ApplicationIcon>
    <AssemblyName>CoachBuild.Desktop</AssemblyName>
    <RootNamespace>CoachBuild.Desktop</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\tray-icon.ico" />
    <Content Include="Assets\tray-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\CoachBuild.Core\CoachBuild.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="0.0.1297" />
  </ItemGroup>
</Project>
