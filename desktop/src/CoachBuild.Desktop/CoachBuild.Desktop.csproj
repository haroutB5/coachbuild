<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms are both enabled for the tray; source uses explicit Wpf*/Forms aliases for shared type names. -->
    <StartupObject>CoachBuild.Desktop.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <Version>2.1.0</Version>
    <ApplicationIcon>Assets\tray-icon.ico</ApplicationIcon>
    <AssemblyName>CoachBuild.Desktop</AssemblyName>
    <RootNamespace>CoachBuild.Desktop</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\tray-icon.ico" />
    <Content Include="Assets\tray-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\CoachBuild.Core\CoachBuild.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="0.0.1297" />
  </ItemGroup>
  <!--
    The Companion ("Draft") tab is served from a static export shipped inside
    the app, not from a hosted origin. Producing it here means a plain
    `dotnet build` / `dotnet publish` always yields a runnable app.
  -->
  <Import Project="..\..\build\DraftUi.targets" />
  <!--
    WorkingDirectory is the UI directory, not the repo root, and that is
    load-bearing: Tailwind auto-discovers tailwind.config.cjs from the process
    cwd. Building from the root instead resolves that config's content globs
    against the root, matches nothing, and emits zero utility classes — a build
    that reports success and ships an unstyled page. See desktop/ui/postcss.config.mjs.
  -->
  <Target Name="BuildDraftUi" BeforeTargets="CollectDraftUiAssets" Condition="'$(DraftUiIsInnerBuild)' != 'true'">
    <Exec WorkingDirectory="$(DraftUiSourceDirectory)" Command="node ../../node_modules/next/dist/bin/next build" />
  </Target>
</Project>
