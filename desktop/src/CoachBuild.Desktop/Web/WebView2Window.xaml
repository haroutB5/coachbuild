<Window x:Class="CoachBuild.Desktop.Web.WebView2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoachBuild.Desktop.Web"
        Title="CoachBuild  •  Research"
        Icon="pack://application:,,,/Assets/tray-icon.ico"
        Width="1280"
        Height="860"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#081321"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#081321" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#0D1C2E" />
        <SolidColorBrush x:Key="ChromeRaisedBrush" Color="#122840" />
        <SolidColorBrush x:Key="LineBrush" Color="#1E3953" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A4BB" />
        <SolidColorBrush x:Key="GoldBrush" Color="#E5B85C" />
        <SolidColorBrush x:Key="GoldBrightBrush" Color="#F2CA70" />
        <SolidColorBrush x:Key="SiteCanvasBrush" Color="#F4F7FA" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#122840" />
            <Setter Property="Foreground" Value="#D8E2EE" />
            <Setter Property="BorderBrush" Value="#25445F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A3A58" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3E6687" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0E2238" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small back/forward/refresh for the merged single chrome row. Same
             template as IconButton, tighter box, so they read as chrome
             beside the tab strip rather than competing with it. -->
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="30" />
        </Style>

        <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#122840" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="#1A3A58" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabChrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryOfferButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#D8A64E" />
            <Setter Property="BorderBrush" Value="#F1C76B" />
            <Setter Property="Foreground" Value="#081321" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="SecondaryOfferButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background" Value="#12283C" />
            <Setter Property="BorderBrush" Value="#2A4A63" />
            <Setter Property="Foreground" Value="#BCD0E1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ChromeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <!-- 2.1.0: ONE chrome row, not two.
             The URL text box and the Zoom -/100%/+ cluster are gone: the
             window has no address bar to type into, so the box was a 300px
             read-only label, and zoom keeps its keyboard shortcuts and its
             per-site persistence (CompanionTabsPreferences) without three
             permanent controls. Back/forward/refresh survive as small buttons
             at the head of the tab row. Net: the 74px row is gone and the
             content area is 74px taller. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <Border x:Name="ChromeRow"
                Grid.Row="0"
                Background="{StaticResource ChromeBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource ChromeText}"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,14,0">
                        <Run Text="COACH" Foreground="{StaticResource GoldBrush}" />
                        <Run Text="BUILD" />
                    </TextBlock>
                    <Button x:Name="BackButton"
                            Style="{StaticResource NavButton}"
                            Content="‹"
                            ToolTip="Back"
                            Click="OnBackClick" />
                    <Button x:Name="ForwardButton"
                            Style="{StaticResource NavButton}"
                            Content="›"
                            ToolTip="Forward"
                            Click="OnForwardClick" />
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource NavButton}"
                            Content="↻"
                            ToolTip="Refresh"
                            Click="OnRefreshClick"
                            Margin="0,0,12,0" />
                    <Border Width="1"
                            Background="{StaticResource LineBrush}"
                            Margin="0,10,12,10" />
                    <Button x:Name="CompanionTabButton"
                            Style="{StaticResource TabButton}"
                            Content="✦  Draft"
                            Click="OnCompanionTabClick" />
                    <Button x:Name="UggTabButton"
                            Style="{StaticResource TabButton}"
                            Content="u.gg"
                            Click="OnUggTabClick" />
                    <Button x:Name="CoachlessTabButton"
                            Style="{StaticResource TabButton}"
                            Content="Coachless"
                            Click="OnCoachlessTabClick" />
                    <Button x:Name="OpGgTabButton"
                            Style="{StaticResource TabButton}"
                            Click="OnOpGgTabClick">
                        <TextBlock>
                            <Run Text="MyStats" />
                            <Run Text="op.gg" FontStyle="Italic" FontSize="10" BaselineAlignment="Subscript" />
                        </TextBlock>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TabStateText"
                           Text="Draft"
                           Style="{StaticResource ChromeText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="0,0,3,0" />
            </Grid>
        </Border>

        <Border x:Name="OfferBar"
                Grid.Row="1"
                Background="#172A3A"
                BorderBrush="#385873"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid Margin="24,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Champ select"
                               Style="{StaticResource ChromeText}"
                               Foreground="{StaticResource GoldBrightBrush}"
                               FontWeight="SemiBold"
                               FontSize="11" />
                    <TextBlock x:Name="OfferHintText"
                               Text="A build is ready to open"
                               Style="{StaticResource ChromeText}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ImportRunesButton"
                            Style="{StaticResource PrimaryOfferButton}"
                            Content="Import runes"
                            ToolTip="Read this page's rune build into the League client."
                            Click="OnImportRunesClick" />
                    <StackPanel x:Name="ChampChipsPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="UggOfferButton"
                                Style="{StaticResource SecondaryOfferButton}"
                                Content="Open u.gg"
                                Click="OnUggOfferClick" />
                        <Button x:Name="CoachlessOfferButton"
                                Style="{StaticResource SecondaryOfferButton}"
                                Content="Open Coachless"
                                Click="OnCoachlessOfferClick" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="OfferCaptionText"
                           Grid.Column="2"
                           Text="Click a site to open"
                           Style="{StaticResource ChromeText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid x:Name="ContentHost"
              Grid.Row="2"
              Background="{StaticResource SiteCanvasBrush}">
            <Grid x:Name="BrowserHost" />

            <!-- Zero-area host for the auto-import's hidden worker webviews.
                 Collapsed would withhold the HWND a WebView2 needs to run, so
                 this stays Visible at 0x0: it paints nothing, hits nothing,
                 and its pages still navigate and script. -->
            <Grid x:Name="AutoImportHost"
                  Width="0"
                  Height="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False" />

            <Grid x:Name="LandingState"
                  Background="#081A2A"
                  Visibility="Visible">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="500">
                    <TextBlock Text="Your research desk"
                               Foreground="#F5F7FA"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                     <TextBlock Text="Open a tab above and keep your draft, stats and coaching notes in one window."
                               Foreground="#A9BACB"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13"
                               Margin="0,10,0,0" />
                    <Border Background="#102A41"
                            BorderBrush="#2D536E"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15,11"
                            Margin="0,28,0,0">
                        <TextBlock Text="Tabs keep separate sign-ins and history. Use the champ offer during champ select when you want a site page."
                                   Foreground="#BCD0E1"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>

            <local:WebView2FallbackView x:Name="Fallback"
                                        Visibility="Collapsed" />

            <Grid x:Name="LoadingOverlay"
                  Background="#E6071422"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Foreground="#D9A94E"
                                 Background="#D5DEE7" />
                    <TextBlock x:Name="LoadingText"
                               Text="Loading…"
                               Foreground="#E7EEF5"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ErrorState"
                  Background="#E6071422"
                  Visibility="Collapsed">
                <Border Background="#102A41"
                        BorderBrush="#385B77"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="28"
                        Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="This page could not load"
                                   Foreground="#F5F7FA"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ErrorText"
                                   Text="Check the connection and try again."
                                   Foreground="#B7C8D8"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"
                                   FontSize="12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Try again"
                                    Style="{StaticResource IconButton}"
                                    Background="#D8A64E"
                                    BorderBrush="#F1C76B"
                                    Foreground="#081321"
                                    Click="OnRetryClick" />
                            <Button Content="Back to home"
                                    Style="{StaticResource IconButton}"
                                    Click="OnHomeClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="StatusRow"
                Grid.Row="3"
                Background="#07111D"
                BorderBrush="#1C354C"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Style="{StaticResource ChromeText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Manual browsing  •  separate site profiles"
                           Style="{StaticResource ChromeText}"
                           Foreground="#657B92"
                           FontSize="10"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
