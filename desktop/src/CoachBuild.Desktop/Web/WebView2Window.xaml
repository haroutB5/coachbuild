<Window x:Class="CoachBuild.Desktop.Web.WebView2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CoachBuild.Desktop.Web"
        Title="CoachBuild"
        Icon="pack://application:,,,/Assets/tray-icon.ico"
        Width="1280"
        Height="860"
        MinWidth="940"
        MinHeight="620"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#0A1420"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- 2.5.0: a custom title bar. WindowChrome removes the Win32 caption and
         reports the top 54px (the whole ChromeRow) as HTCAPTION, so Aero snap,
         edge resize, double-click maximise and Alt+Space keep working with no
         code: the OS owns all of them. Buttons in the row stay clickable
         because each one sets IsHitTestVisibleInChrome; everything else drags.
         The system menu on right-click IS wired by hand (OnChromeRightButtonUp)
         because WindowStyle=None no longer shows it for free. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#0A1420" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#0D1C2E" />
        <SolidColorBrush x:Key="ChromeRaisedBrush" Color="#122840" />
        <SolidColorBrush x:Key="LineBrush" Color="#1E3953" />
        <SolidColorBrush x:Key="TextBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A4BB" />
        <SolidColorBrush x:Key="GoldBrush" Color="#E5B85C" />
        <SolidColorBrush x:Key="SiteCanvasBrush" Color="#F4F7FA" />

        <!-- 2.5.0 native chrome palette (measured off the 1586x992 mocks). -->
        <SolidColorBrush x:Key="ChromeBarBrush" Color="#0C1520" />
        <SolidColorBrush x:Key="ChromeLineBrush" Color="#1A2636" />
        <SolidColorBrush x:Key="ChromeHoverBrush" Color="#15263A" />
        <SolidColorBrush x:Key="ChromePressedBrush" Color="#0E1E30" />
        <SolidColorBrush x:Key="ChromeTextBrush" Color="#C6D2DF" />
        <SolidColorBrush x:Key="ChromeTitleBrush" Color="#F2F6FA" />
        <SolidColorBrush x:Key="GoldPillBrush" Color="#F2BE4F" />
        <SolidColorBrush x:Key="GoldPillBgBrush" Color="#121C26" />
        <SolidColorBrush x:Key="FooterBrush" Color="#0B131D" />
        <SolidColorBrush x:Key="DividerBrush" Color="#1D2C3F" />
        <SolidColorBrush x:Key="StatusMutedBrush" Color="#8FA3B8" />
        <SolidColorBrush x:Key="CloseHoverBrush" Color="#C42B1C" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#122840" />
            <Setter Property="Foreground" Value="#D8E2EE" />
            <Setter Property="BorderBrush" Value="#25445F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1A3A58" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#3E6687" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0E2238" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless 36x36 nav buttons. Same click handlers and disabled
             states as before; only the box changed. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavChrome" Property="Background" Value="{StaticResource ChromePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="NavChrome" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab strip buttons. Inactive tabs are plain text; the ACTIVE tab
             gets the gold pill via SetTabVisual (background, 2px gold border,
             gold semibold text, diamond shown). The border stays 2px in both
             states (transparent when inactive) so switching tabs never moves
             its neighbours. The hover trigger is Tag-gated for the same
             reason: without the gate it would paint over the gold pill. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TabChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TabChrome" Property="Background" Value="{StaticResource ChromePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-height caption buttons (46x54), no radius, OS-style. -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionChrome"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="{StaticResource ChromePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionChrome"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="{StaticResource CloseHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="#A4261B" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterNoteButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NoteChrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NoteChrome" Property="Background" Value="{StaticResource ChromeHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NoteChrome" Property="Background" Value="{StaticResource ChromePressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LiveSetupLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChromeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
    </Window.Resources>

    <!-- When maximised the WindowChrome frame would clip the chrome against
         the screen edges; UpdateWindowControls pads the whole tree by the
         6px resize border instead (see OnStateChanged). -->
    <Grid x:Name="RootGrid" Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- ONE 54px chrome row: logo, wordmark, nav, tabs, caption buttons.
             The whole Border is the draggable caption except the buttons. -->
        <Border x:Name="ChromeRow"
                Grid.Row="0"
                Background="{StaticResource ChromeBarBrush}"
                BorderBrush="{StaticResource ChromeLineBrush}"
                BorderThickness="0,0,0,1"
                MouseRightButtonUp="OnChromeRightButtonUp"
                SizeChanged="OnChromeSizeChanged">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogo"
                           Source="pack://application:,,,/Assets/tray-icon.ico"
                           Width="32"
                           Height="32"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                    <TextBlock x:Name="BrandText"
                               Text="CoachBuild"
                               FontFamily="Segoe UI"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource ChromeTitleBrush}"
                               Width="130"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center" />
                    <Border x:Name="ChromeDivider"
                            Width="1"
                            Height="30"
                            Background="{StaticResource DividerBrush}"
                            Margin="17,0,0,0"
                            VerticalAlignment="Center" />
                    <Button x:Name="BackButton"
                            Style="{StaticResource NavButton}"
                            Content="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                            ToolTip="Back"
                            AutomationProperties.Name="Back"
                            Margin="13,0,0,0"
                            Click="OnBackClick" />
                    <Button x:Name="ForwardButton"
                            Style="{StaticResource NavButton}"
                            Content="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                            ToolTip="Forward"
                            AutomationProperties.Name="Forward"
                            Margin="8,0,0,0"
                            Click="OnForwardClick" />
                    <Button x:Name="RefreshButton"
                            Style="{StaticResource NavButton}"
                            Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                            ToolTip="Refresh"
                            AutomationProperties.Name="Refresh"
                            Margin="8,0,0,0"
                            Click="OnRefreshClick" />
                    <Button x:Name="CompanionTabButton"
                            Style="{StaticResource TabButton}"
                            AutomationProperties.Name="Draft"
                            Margin="29,0,0,0"
                            MinWidth="108"
                            Click="OnCompanionTabClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CompanionDiamond"
                                       Text="&#x25C6;"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="CompanionTabText" Text="Draft" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="UggTabButton"
                            Style="{StaticResource TabButton}"
                            AutomationProperties.Name="u.gg"
                            Margin="28,0,0,0"
                            Click="OnUggTabClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="UggDiamond"
                                       Text="&#x25C6;"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="UggTabText" Text="u.gg" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CoachlessTabButton"
                            Style="{StaticResource TabButton}"
                            AutomationProperties.Name="Coachless"
                            Margin="8,0,0,0"
                            Click="OnCoachlessTabClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="CoachlessDiamond"
                                       Text="&#x25C6;"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="CoachlessTabText" Text="Coachless" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpGgTabButton"
                            Style="{StaticResource TabButton}"
                            AutomationProperties.Name="MyStats op.gg"
                            Margin="8,0,0,0"
                            Click="OnOpGgTabClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="OpGgDiamond"
                                       Text="&#x25C6;"
                                       FontSize="16"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                            <TextBlock x:Name="OpGgTabText" Text="MyStats op.gg" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="WindowControls"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,16,0">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource WindowControlButton}"
                            Content="&#xE921;"
                            ToolTip="Minimise"
                            AutomationProperties.Name="Minimise"
                            Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource WindowControlButton}"
                            ToolTip="Maximise"
                            AutomationProperties.Name="Maximise"
                            Margin="15,0,0,0"
                            Click="OnMaximizeClick">
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" />
                    </Button>
                    <Button x:Name="CloseButton"
                            Style="{StaticResource WindowCloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            AutomationProperties.Name="Close"
                            Margin="15,0,0,0"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentHost"
              Grid.Row="1"
              Background="{StaticResource SiteCanvasBrush}">
            <Grid x:Name="BrowserHost" />

            <!-- Zero-area host for the auto-import's hidden worker webviews.
                  Collapsed would withhold the HWND a WebView2 needs to run, so
                  this stays Visible at 0x0: it paints nothing, hits nothing,
                  and its pages still navigate and script. -->
            <Grid x:Name="AutoImportHost"
                  Width="0"
                  Height="0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False" />

            <Grid x:Name="LandingState"
                  Background="#081A2A"
                  Visibility="Visible">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="500">
                    <TextBlock Text="Your research desk"
                               Foreground="#F5F7FA"
                               FontSize="28"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                     <TextBlock Text="Open a tab above and keep your draft, stats and coaching notes in one window."
                               Foreground="#A9BACB"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13"
                               Margin="0,10,0,0" />
                    <Border Background="#102A41"
                            BorderBrush="#2D536E"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15,11"
                            Margin="0,28,0,0">
                        <TextBlock Text="Tabs keep separate sign-ins and history. Builds and both rune pages import automatically on champion lock."
                                   Foreground="#BCD0E1"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>

            <local:WebView2FallbackView x:Name="Fallback"
                                        Visibility="Collapsed" />

            <Grid x:Name="LoadingOverlay"
                  Background="#E6071422"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220"
                                 Height="3"
                                 IsIndeterminate="True"
                                 Foreground="#D9A94E"
                                 Background="#D5DEE7" />
                    <TextBlock x:Name="LoadingText"
                               Text="Loading…"
                               Foreground="#E7EEF5"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Grid>

            <Grid x:Name="ErrorState"
                  Background="#E6071422"
                  Visibility="Collapsed">
                <Border Background="#102A41"
                        BorderBrush="#385B77"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="28"
                        Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="This page could not load"
                                   Foreground="#F5F7FA"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ErrorText"
                                   Text="Check the connection and try again."
                                   Foreground="#B7C8D8"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"
                                   FontSize="12" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Try again"
                                    Style="{StaticResource IconButton}"
                                    Background="#D8A64E"
                                    BorderBrush="#F1C76B"
                                    Foreground="#081321"
                                    Click="OnRetryClick" />
                            <Button Content="Back to home"
                                    Style="{StaticResource IconButton}"
                                    Click="OnHomeClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 44px footer: live-setup link + companion version, status notes,
             and the separate-profiles note with its explanation popup. -->
        <Border x:Name="StatusRow"
                Grid.Row="2"
                Background="{StaticResource FooterBrush}"
                BorderBrush="{StaticResource ChromeLineBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="FooterGear"
                               Text="&#xE713;"
                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol"
                               FontSize="22"
                               Foreground="{StaticResource ChromeTextBrush}"
                               Width="22"
                               TextAlignment="Center"
                               Margin="30,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterInfoText"
                               FontFamily="Segoe UI"
                               FontSize="15"
                               Foreground="{StaticResource ChromeTextBrush}"
                               Margin="28,0,0,0"
                               VerticalAlignment="Center">
                        <Hyperlink x:Name="LiveSetupLink"
                                   Style="{StaticResource LiveSetupLinkStyle}"
                                   Click="OnLiveSetupClick">Live setup</Hyperlink>
                        <Run x:Name="FooterVersionText" Text=" · Companion …" />
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Ready"
                           Visibility="Collapsed"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           Foreground="{StaticResource StatusMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="ProfilesButton"
                        Grid.Column="2"
                        Style="{StaticResource FooterNoteButton}"
                        Content="Separate site profiles ›"
                        ToolTip="Each site tab keeps its own sign-in, cookies and history. Nothing is shared between tabs or with your normal browser."
                        AutomationProperties.Name="Separate site profiles. Show explanation."
                        Margin="0,0,19,0"
                        VerticalAlignment="Center"
                        Click="OnProfilesClick" />
                <Popup x:Name="ProfilesPopup"
                       Grid.Column="2"
                       PlacementTarget="{Binding ElementName=ProfilesButton}"
                       Placement="Top"
                       HorizontalOffset="-40"
                       VerticalOffset="-8"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="{StaticResource GoldPillBgBrush}"
                            BorderBrush="{StaticResource ChromeLineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <TextBlock Text="Each site tab keeps its own sign-in, cookies and history. Nothing is shared between tabs or with your normal browser."
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="{StaticResource ChromeTextBrush}"
                                   TextWrapping="Wrap"
                                   MaxWidth="320" />
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
