<UserControl x:Class="CoachBuild.Desktop.Web.WebView2FallbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0D0B">
    <Grid Margin="36">
        <Border Background="#121A25"
                BorderBrush="#53627D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="560">
            <StackPanel>
                <TextBlock Text="CoachBuild needs WebView2"
                           Foreground="#FFFFFF"
                           FontSize="25"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText"
                           Text="Install or repair the Evergreen WebView2 runtime, then retry this page."
                           Foreground="#D7DCE7"
                           TextWrapping="Wrap"
                           Margin="0,12,0,18" />
                <Button x:Name="RepairButton"
                        Content="Repair WebView2 runtime"
                        Padding="16,9"
                        HorizontalAlignment="Left"
                        Click="OnRepairClick" />
                <TextBlock Text="CoachBuild stays in this window; no default browser is opened."
                           Foreground="#9EA8BC"
                           FontSize="11"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
